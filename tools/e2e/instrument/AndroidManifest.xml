<!-- Test-only instrumentation. It runs inside Luma's process. MediaE2E drives Up Next against the real TV provider.
     JourneysE2E drives remote journeys through Home, Apps and the Capabilities panel. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.luma.tv.e2e" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <instrumentation android:name="dev.luma.tv.MediaE2E" android:targetPackage="dev.luma.tv.e2e.target" android:label="Luma media E2E" />
    <instrumentation android:name="dev.luma.tv.JourneysE2E" android:targetPackage="dev.luma.tv.e2e.target" android:label="Luma journeys E2E" />
    <application android:label="Luma media E2E" android:hasCode="true" />
</manifest>
